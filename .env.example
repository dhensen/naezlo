# Copy to .env and adjust. Never commit real secrets; .env is git-ignored.

# Display name of the product (working name; see DECISIONS.md).
APP_NAME=todolist

# development | test | production
ENVIRONMENT=development

# PostgreSQL (SQLAlchemy URL with the asyncpg driver). These match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://todolist:todolist@localhost:5435/todolist
# Used by the test suite only. Its schema is dropped and re-migrated on every test run.
TEST_DATABASE_URL=postgresql+asyncpg://todolist:todolist@localhost:5435/todolist_test
