# Copy to .env and adjust. Never commit real secrets; .env is git-ignored.

# Display name of the product (working name; see DECISIONS.md).
APP_NAME=todolist

# development | test | production
ENVIRONMENT=development

# PostgreSQL (SQLAlchemy URL with the asyncpg driver). These match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://todolist:todolist@localhost:5435/todolist
# Used by the test suite only. Its schema is dropped and re-migrated on every test run.
TEST_DATABASE_URL=postgresql+asyncpg://todolist:todolist@localhost:5435/todolist_test
# Used by the browser tests only (npm --prefix frontend run e2e). It is created when missing and
# emptied and re-migrated on every run; its name must end with _e2e.
E2E_DATABASE_URL=postgresql+asyncpg://todolist:todolist@localhost:5435/todolist_e2e

# Signs the session cookie. Required when ENVIRONMENT=production; the app refuses to start
# without it there. Generate a value with: openssl rand -hex 32
SESSION_SECRET=change-me

# true enables POST /api/auth/dev-login (sign in as any email, no password). Local development
# and end-to-end tests only; the app refuses to start with it when ENVIRONMENT=production.
DEV_LOGIN=false

# The URL people open the app on in their browser, without a trailing slash. It is also the
# OAuth issuer for MCP clients (the MCP endpoint is <PUBLIC_BASE_URL>/mcp). With the Vite
# dev server that is http://localhost:5173.
PUBLIC_BASE_URL=http://localhost:8000

# The built frontend (npm --prefix frontend run build), relative to the working directory.
# FastAPI serves it when it exists at startup. In development use the Vite dev server instead.
FRONTEND_DIST=frontend/dist

# Google OAuth client for "Sign in with Google" (Google Cloud console > Credentials > OAuth
# client ID > Web application). Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/google/callback
# Google login is off while either value is empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
